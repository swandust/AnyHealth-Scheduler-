# ============================================================================
# AnyHealth Scheduler — copy to .env.local and fill in.
# Every one of these also has to be added in Vercel → Settings → Environment
# Variables. See SETUP.md for where each value comes from.
# ============================================================================

# ── Supabase (where the answers are saved) ─────────────────────────────────
# Project Settings → API. The service role key is server-side ONLY.
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── Google (calendar event + Meet link + sending the email) ────────────────
# One OAuth credential covers all three. Enable BOTH the Google Calendar API
# and the Gmail API in console.cloud.google.com → APIs & Services → Library.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxx
# Produced by: npm run google:auth
# Must carry the calendar.events, calendar.readonly and gmail.send scopes.
# After adding a scope you must mint a NEW token — an existing one is never
# upgraded, it just starts failing with 403 insufficient scopes.
GOOGLE_REFRESH_TOKEN=1//0gxxxxxxxxxxxx
# 'primary' = the main calendar of the account you authorised above.
GOOGLE_CALENDAR_ID=primary

# ── Mail transport ─────────────────────────────────────────────────────────
# 'gmail' sends through the Google account above — no mail password at all.
# 'smtp' uses the SMTP_* settings below instead (Zoho Mail, ZeptoMail, …).
# Leave unset to use Gmail when Google is configured, otherwise SMTP.
MAIL_TRANSPORT=gmail

# ── SMTP — only needed when MAIL_TRANSPORT=smtp ────────────────────────────
# Zoho Mail: smtp.zoho.com (or .eu / .in / .com.au / .sa for other regions).
# ZeptoMail: smtp.zeptomail.com
# Port 465 with SMTP_SECURE=true, or 587 with SMTP_SECURE=false.
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=contact@anyhealth.asia
# An app-specific password, NOT your normal login password.
# SMTP_PASSWORD=

# ── Addresses ──────────────────────────────────────────────────────────────
# On the gmail transport, FROM_EMAIL must be the Google account itself or one
# of its verified "Send mail as" aliases. Otherwise Gmail silently rewrites
# the From header to the account's own address — /api/admin/health warns you.
FROM_EMAIL=contact@anyhealth.asia
FROM_NAME=AnyHealth
NOTIFY_EMAIL=contact@anyhealth.asia
REPLY_TO_EMAIL=contact@anyhealth.asia

# ── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://anyhealth-scheduler.vercel.app

# ── Schedule ───────────────────────────────────────────────────────────────
# 0=Sun 1=Mon … 6=Sat
AVAILABLE_DAYS=1,2,3,4,5,6
BOOKING_TIMEZONE=Asia/Singapore
SLOT_DURATION_MINUTES=30
# Don't offer a slot starting sooner than this many minutes from now.
MIN_NOTICE_MINUTES=60

# ── Website analytics link (see ANALYTICS.md) ──────────────────────────────
# The cookie/localStorage key your site's tracker stores visitor_id under.
# Find it in DevTools → Application → Cookies. If this is wrong, bookings
# simply won't be attributed — nothing breaks loudly, so check /admin.
NEXT_PUBLIC_VISITOR_COOKIE=ah_vid
NEXT_PUBLIC_SESSION_COOKIE=ah_sid
# Only if the site and the scheduler share a registrable domain, e.g. the site
# on anyhealth.asia and this app on book.anyhealth.asia:
# NEXT_PUBLIC_COOKIE_DOMAIN=.anyhealth.asia

# ── Admin screen (/admin) ──────────────────────────────────────────────────
# Any random string, at least 16 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_TOKEN=

# ── Old Zoom credentials — ONLY for `npm run recover -- --zoom` ────────────
# Delete these once the history has been pulled back in.
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
